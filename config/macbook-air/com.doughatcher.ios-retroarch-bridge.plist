<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.doughatcher.ios-retroarch-bridge</string>
  <key>ProgramArguments</key><array><string>/Applications/Xcode.app/Contents/Developer/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3.9</string><string>/Users/me/.local/bin/ios-retroarch-bridge.py</string><string>--reconcile</string></array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/ios-retroarch-bridge.log</string>
  <key>StandardErrorPath</key><string>/tmp/ios-retroarch-bridge.err</string>
</dict></plist>
