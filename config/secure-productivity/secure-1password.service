[Unit]
Description=1Password app and SSH agent for encrypted desktop
After=remote-productivity-shell.service
Requires=remote-productivity-shell.service

[Service]
ExecStart=/usr/local/libexec/launch-secure-1password.sh
Environment=WAYLAND_DISPLAY=wayland-productivity
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
