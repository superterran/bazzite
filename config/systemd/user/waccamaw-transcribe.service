[Unit]
Description=Waccamaw tribal meeting transcription (WhisperX + VAD + diarization)
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/me/repos/waccamaw-archive/transcribe
ExecStart=/home/me/repos/waccamaw-archive/transcribe/run.sh
Restart=on-failure
RestartSec=30
Nice=10

[Install]
WantedBy=default.target
