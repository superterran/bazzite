[Unit]
Description=Kokoro TTS Server (GPU)
Documentation=https://github.com/remsky/Kokoro-FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f kokoro-tts
ExecStart=/usr/bin/docker run --rm --name kokoro-tts \
  --gpus all \
  -p 8880:8880 \
  ghcr.io/remsky/kokoro-fastapi-gpu:v0.2.4-master
ExecStop=/usr/bin/docker stop kokoro-tts
Restart=on-failure
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
