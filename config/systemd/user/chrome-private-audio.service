[Unit]
Description=Private browser audio independent of the TV
Requires=chrome-private-display.service
After=chrome-private-display.service
BindsTo=chrome-private-display.service

[Service]
ExecStart=%h/repos/bazzite/bin/chrome-private-session.sh audio
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
