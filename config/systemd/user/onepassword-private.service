[Unit]
Description=1Password desktop and SSH agent on the private desktop
Requires=chrome-private-display.service chrome-private-wm.service
After=chrome-private-display.service chrome-private-wm.service
BindsTo=chrome-private-display.service

[Service]
Environment=DISPLAY=:20
Environment=XAUTHORITY=%t/chrome-private/Xauthority
Environment=ELECTRON_OZONE_PLATFORM_HINT=x11
UnsetEnvironment=WAYLAND_DISPLAY
ExecStart=/usr/bin/1password --ozone-platform=x11
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
