[Unit]
Description=Wellbeing Bridge (Apple Health webhook receiver)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/home/me/repos/wellbeing-mcp
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/home/me/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/home/linuxbrew/.linuxbrew/bin/uv run python -m wellbeing_mcp.bridge
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wellbeing-bridge

[Install]
WantedBy=default.target
