[Unit]
Description=mcpvault Remote SSE Bridge
After=network-online.target obsidian-sync.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/home/me/repos/mcpvault-remote
EnvironmentFile=/var/home/me/repos/mcpvault-remote/.env
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/home/me/.nvm/versions/node/v24.14.0/bin:/usr/local/bin:/usr/bin
Environment=HOME=/home/me
ExecStart=/home/me/.nvm/versions/node/v24.14.0/bin/node /var/home/me/repos/mcpvault-remote/server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcpvault-remote

[Install]
WantedBy=default.target
