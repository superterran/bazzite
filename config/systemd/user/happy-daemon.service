[Unit]
Description=Happy Daemon (Claude Code on the Go)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=/home/me/.nvm/versions/node/v24.14.0/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin
Environment=HOME=/home/me
ExecStart=/home/me/.nvm/versions/node/v24.14.0/bin/happy daemon start-sync
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
